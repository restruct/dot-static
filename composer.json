{
  "name": "restruct/dot-static",
  "description": "Statically compiled Graphviz dot for Linux x64 (SVG, HTML labels, no dependencies), with a fluent PHP DOT builder, SVG renderer and browser fallback",
  "keywords": ["php", "graphviz", "dot", "svg", "diagram", "graph-visualization", "static-binaries"],
  "license": "(MIT AND EPL-1.0)",
  "authors"    : [
    {
      "name": "Restruct",
      "email": "dev@restruct.nl",
      "homepage": "https://restruct.nl",
      "role": "Developer (SilverStripe module)"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/process": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Restruct\\Dot\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\Dot\\Tests\\": "tests/"
    }
  },
  "extra": {
    "expose": [
      "client"
    ]
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ]
}
